{
  "id": "a1-polynomials-02",
  "version": 2,
  "title": "Zero and negative exponents",
  "xp": 15,
  "tags": [
    "algebra",
    "polynomials"
  ],
  "learn": [
    {
      "id": "zero",
      "kind": "text",
      "title": "The zero exponent",
      "body": "What is $x^0$? Use the quotient rule: $\\frac{x^3}{x^3}=x^{3-3}=x^0$. But anything divided by itself is 1. So $x^0=1$ for any $x$ that is not 0."
    },
    {
      "id": "negative",
      "kind": "text",
      "title": "Negative exponents",
      "body": "Keep going with the quotient rule: $\\frac{x^2}{x^5}=x^{-3}$. Cancelling gives $\\frac{1}{x^3}$. So $x^{-n}=\\frac{1}{x^n}$. A negative exponent means reciprocal, not a negative number."
    },
    {
      "id": "example-numbers",
      "kind": "example",
      "title": "Evaluate with numbers",
      "body": "Both rules in action.",
      "steps": [
        "$5^0=1$",
        "$2^{-3}=\\frac{1}{2^3}=\\frac{1}{8}$",
        "$10^{-2}=\\frac{1}{100}=0.01$"
      ]
    },
    {
      "id": "example-simplify",
      "kind": "example",
      "title": "Simplify $x^3\\cdot x^{-5}$",
      "body": "The product rule still applies.",
      "steps": [
        "Add exponents: $3+(-5)=-2$",
        "$x^{-2}=\\frac{1}{x^2}$"
      ]
    },
    {
      "id": "sign",
      "kind": "tip",
      "body": "$2^{-3}$ is a small positive number, $\\frac{1}{8}$. The minus sign in the exponent flips to the bottom of a fraction."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "What is $7^0$?",
      "choices": [
        "$0$",
        "$1$",
        "$7$"
      ],
      "answerIndex": 1,
      "explanation": "Any nonzero number to the power 0 is 1."
    },
    {
      "id": "q2",
      "type": "type_answer",
      "prompt": "$2^{-3}=\\frac{1}{n}$. Find $n$.",
      "accepted": [
        "8",
        "8.0"
      ],
      "keypad": "numeric",
      "explanation": "$2^{-3}=\\frac{1}{2^3}=\\frac{1}{8}$."
    },
    {
      "id": "q3",
      "type": "type_answer",
      "prompt": "Write $10^{-2}$ as a decimal.",
      "accepted": [
        "0.01",
        ".01"
      ],
      "keypad": "numeric",
      "explanation": "$10^{-2}=\\frac{1}{100}=0.01$."
    },
    {
      "id": "q4",
      "type": "fill_blank",
      "prompt": "$4^{-1}=\\frac{1}{\\_\\_}$",
      "choices": [
        "$-4$",
        "$4$",
        "$1$"
      ],
      "answerIndex": 1,
      "explanation": "A negative exponent means take the reciprocal. $4^{-1}$ is one over 4."
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "Rewrite $x^{-3}$ with a positive exponent.",
      "choices": [
        "$-x^3$",
        "$\\frac{1}{x^{-3}}$",
        "$\\frac{1}{x^3}$"
      ],
      "answerIndex": 2,
      "explanation": "A negative exponent moves the power to the bottom: $x^{-3}=\\frac{1}{x^3}$."
    },
    {
      "id": "q6",
      "type": "type_answer",
      "prompt": "$3^2\\cdot3^{-2}=$ ?",
      "accepted": [
        "1",
        "1.0"
      ],
      "keypad": "numeric",
      "explanation": "Add exponents: $3^{2+(-2)}=3^0=1$."
    },
    {
      "id": "q7",
      "type": "multiple_choice",
      "prompt": "Simplify $x^5\\cdot x^{-7}$",
      "choices": [
        "$x^2$",
        "$\\frac{1}{x^2}$",
        "$-x^2$"
      ],
      "answerIndex": 1,
      "explanation": "Add exponents: $5+(-7)=-2$, so $x^{-2}=\\frac{1}{x^2}$."
    },
    {
      "id": "q8",
      "type": "type_answer",
      "prompt": "$5^{-2}\\cdot5^3=$ ?",
      "accepted": [
        "5",
        "5.0"
      ],
      "keypad": "numeric",
      "explanation": "Add exponents: $-2+3=1$, so the answer is $5^1=5$."
    }
  ]
}
