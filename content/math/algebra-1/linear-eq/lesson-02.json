  ],
  "learn": [
    {
      "id": "two-operations",
      "kind": "text",
      "title": "Two operations",
      "body": "In $2x+3=7$, $x$ is multiplied by 2 and then 3 is added. To solve it, undo the operations in reverse order: first the adding or subtracting, then the multiplying or dividing."
    },
    {
      "id": "example-two-step-a",
      "kind": "example",
      "title": "Solve $2x+3=7$",
      "body": "Undo the +3 first, then the ×2.",
      "steps": [
        "Subtract 3 from both sides: $2x=4$",
        "Divide both sides by 2: $x=2$",
        "Check: $2\\cdot 2+3=7$."
      ]
    },
    {
      "id": "example-two-step-b",
      "kind": "example",
      "title": "Solve $3x-4=11$",
      "body": "Undo the −4 first, then the ×3.",
      "steps": [
        "Add 4 to both sides: $3x=15$",
        "Divide both sides by 3: $x=5$",
        "Check: $3\\cdot 5-4=11$."
      ]
    },
    {
      "id": "reverse-order",
      "kind": "tip",
      "body": "Think of getting dressed. Socks go on before shoes, so shoes come off before socks. Undo the last thing that was done to $x$ first."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Solve $2x+1=9$",
      "choices": [
        "$x=4$",
        "$x=5$",
        "$x=8$"
      ],
      "answerIndex": 0,
      "explanation": "Subtract 1 to get $2x=8$, then divide by 2: $x=4$."
    },
    {
      "id": "q2",
      "type": "type_answer",
      "prompt": "$3x-4=11$, so $x=$ ?",
      "accepted": [
        "5"
      ],
      "keypad": "numeric",
      "explanation": "Add 4 to get $3x=15$, then divide by 3."
    },
    {
      "id": "q3",
      "type": "order_steps",
      "prompt": "Solve $5x-2=18$. Put the steps in order.",
      "steps": [
        "Add 2 to both sides",
        "Divide both sides by 5",
        "State that x is 4"
      ],
      "explanation": "Undo the subtraction first, then the multiplication."
    }
  ]
}
