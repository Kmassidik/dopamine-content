{
  "id": "a1-systems-02",
  "version": 2,
  "title": "Compound and absolute value",
  "xp": 20,
  "tags": [
    "algebra",
    "systems"
  ],
  "learn": [
    {
      "id": "compound",
      "kind": "text",
      "title": "And, or",
      "body": "A compound inequality joins two conditions. With and, both must hold, like $-2< x<3$. With or, at least one must hold, like $x<2$ or $x>5$."
    },
    {
      "id": "example-and",
      "kind": "example",
      "title": "Solve $-1<2x+3<9$",
      "body": "Do each step to all three parts.",
      "steps": [
        "Subtract 3: $-4<2x<6$",
        "Divide by 2: $-2< x<3$",
        "Test $x=0$: $-1<3<9$ is true."
      ]
    },
    {
      "id": "abs",
      "kind": "text",
      "title": "Absolute value",
      "body": "$|x|$ is the distance from zero. So $|x|=4$ means $x=4$ or $x=-4$. $|x|<3$ means $-3< x<3$ (and). $|x|>3$ means $x<-3$ or $x>3$ (or)."
    },
    {
      "id": "example-abs",
      "kind": "example",
      "title": "Solve $|x-2|=5$",
      "body": "Split into two cases.",
      "steps": [
        "Positive case: $x-2=5$, so $x=7$",
        "Negative case: $x-2=-5$, so $x=-3$",
        "Check: $|7-2|=5$ and $|-3-2|=5$."
      ]
    },
    {
      "id": "distance",
      "kind": "tip",
      "body": "Think of $|x-2|<5$ as: x is less than 5 steps from 2. That is the range $-3< x<7$."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Solve $|x|=4$",
      "choices": [
        "$x=4$ only",
        "$x=4$ or $x=-4$",
        "$x=-4$ only"
      ],
      "answerIndex": 1,
      "explanation": "Both 4 and $-4$ are 4 steps from zero."
    },
    {
      "id": "q2",
      "type": "type_answer",
      "prompt": "Solve $|x-2|=5$. What is the larger solution?",
      "accepted": [
        "7",
        "7.0"
      ],
      "keypad": "numeric",
      "explanation": "$x-2=5$ or $x-2=-5$, so $x=7$ or $x=-3$."
    },
    {
      "id": "q3",
      "type": "type_answer",
      "prompt": "Solve $|x-2|=5$. What is the smaller solution?",
      "accepted": [
        "-3",
        "-3.0"
      ],
      "keypad": "numeric",
      "explanation": "$x-2=-5$ gives $x=-3$."
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "What does $|x|<3$ mean?",
      "choices": [
        "$x<-3$ or $x>3$",
        "$-3< x<3$",
        "$x<3$"
      ],
      "answerIndex": 1,
      "explanation": "Less than 3 steps from zero means between $-3$ and 3."
    },
    {
      "id": "q5",
      "type": "fill_blank",
      "prompt": "$|x|>3$ means \\_\\_",
      "choices": [
        "$-3< x<3$",
        "$x>3$ only",
        "$x<-3$ or $x>3$"
      ],
      "answerIndex": 2,
      "explanation": "More than 3 steps from zero can be on either side of zero."
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "Solve $-1<2x+3<9$",
      "choices": [
        "$-2< x<3$",
        "$-4< x<6$",
        "$-1< x<9$"
      ],
      "answerIndex": 0,
      "explanation": "Subtract 3 from all three parts: $-4<2x<6$. Divide all by 2: $-2< x<3$."
    },
    {
      "id": "q7",
      "type": "multiple_choice",
      "prompt": "Which number satisfies $x<2$ or $x>5$?",
      "choices": [
        "$x=3$",
        "$x=1$",
        "$x=5$"
      ],
      "answerIndex": 1,
      "explanation": "1 is below 2. Neither 3 nor 5 is below 2 or above 5."
    },
    {
      "id": "q8",
      "type": "type_answer",
      "prompt": "How many whole numbers solve $|x+1|<4$?",
      "accepted": [
        "7",
        "7.0"
      ],
      "keypad": "numeric",
      "explanation": "$-4< x+1<4$ gives $-5< x<3$, so $x=-4,-3,-2,-1,0,1,2$: seven numbers."
    },
    {
      "id": "q9",
      "type": "type_answer",
      "prompt": "The equation $|2x-1|=7$ has two solutions. What is their sum?",
      "accepted": [
        "1",
        "1.0"
      ],
      "keypad": "numeric",
      "explanation": "$2x-1=7$ gives $x=4$. $2x-1=-7$ gives $x=-3$. The sum is $1$."
    }
  ]
}
