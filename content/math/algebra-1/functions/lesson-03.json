{
  "id": "a1-functions-03",
  "version": 2,
  "title": "Slope-intercept form",
  "xp": 15,
  "tags": [
    "algebra",
    "functions"
  ],
  "learn": [
    {
      "id": "form",
      "kind": "text",
      "title": "The form $y=mx+b$",
      "body": "Many lines are written as $y=mx+b$. Here $m$ is the slope and $b$ is the $y$-intercept, the height where the line crosses the vertical axis. The equation $y=2x+3$ has slope 2 and intercept 3."
    },
    {
      "id": "example-write",
      "kind": "example",
      "title": "Write the equation",
      "body": "A line has slope 4 and passes through $(0,-2)$.",
      "steps": [
        "The point $(0,-2)$ is on the $y$-axis, so $b=-2$",
        "The slope is $m=4$",
        "The equation is $y=4x-2$"
      ]
    },
    {
      "id": "example-find-b",
      "kind": "example",
      "title": "Find $b$ from a point",
      "body": "A line has slope 3 and passes through $(2,7)$.",
      "steps": [
        "Start with $y=3x+b$",
        "Put in the point: $7=3\\cdot2+b$",
        "So $b=1$ and the line is $y=3x+1$"
      ]
    },
    {
      "id": "rearrange",
      "kind": "text",
      "title": "Get $y$ alone",
      "body": "If an equation is not in this form, solve for $y$. For $3x+y=5$ subtract $3x$ to get $y=-3x+5$. Now the slope is $-3$ and the intercept is 5."
    },
    {
      "id": "divide-all",
      "kind": "tip",
      "body": "When you divide by a number, divide every term. In $2y=4x+6$ the result is $y=2x+3$."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "What is the slope of $y=5x-2$?",
      "choices": [
        "$-2$",
        "$5$",
        "$x$"
      ],
      "answerIndex": 1,
      "explanation": "In $y=mx+b$ the slope is the number multiplying $x$, here 5."
    },
    {
      "id": "q2",
      "type": "type_answer",
      "prompt": "What is the $y$-intercept of $y=-3x+7$?",
      "accepted": [
        "7",
        "7.0"
      ],
      "keypad": "numeric",
      "explanation": "$b=7$. The line crosses the $y$-axis at $(0,7)$."
    },
    {
      "id": "q3",
      "type": "fill_blank",
      "prompt": "In $y=mx+b$, the letter $b$ is the \\_\\_",
      "choices": [
        "$y$-intercept",
        "slope",
        "$x$-intercept"
      ],
      "answerIndex": 0,
      "explanation": "When $x=0$ we get $y=b$, so the line crosses the vertical axis at $b$."
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "Which line has slope 4 and $y$-intercept $-2$?",
      "choices": [
        "$y=-2x+4$",
        "$y=4x-2$",
        "$y=4x+2$"
      ],
      "answerIndex": 1,
      "explanation": "Slope goes with $x$, and the intercept is the constant on its own."
    },
    {
      "id": "q5",
      "type": "type_answer",
      "prompt": "A line has slope 3 and passes through $(2,7)$. Find $b$.",
      "accepted": [
        "1",
        "1.0"
      ],
      "keypad": "numeric",
      "explanation": "$7=3\\cdot2+b$, so $b=1$."
    },
    {
      "id": "q6",
      "type": "type_answer",
      "prompt": "For $y=2x+3$, find $y$ when $x=5$.",
      "accepted": [
        "13",
        "13.0"
      ],
      "keypad": "numeric",
      "explanation": "$2\\cdot5+3=13$."
    },
    {
      "id": "q7",
      "type": "multiple_choice",
      "prompt": "What is the slope of $3x+y=5$?",
      "choices": [
        "$3$",
        "$-3$",
        "$5$"
      ],
      "answerIndex": 1,
      "explanation": "Subtract $3x$: $y=-3x+5$. The slope is $-3$."
    },
    {
      "id": "q8",
      "type": "multiple_choice",
      "prompt": "What is the slope of $2y=4x+6$?",
      "choices": [
        "$4$",
        "$6$",
        "$2$"
      ],
      "answerIndex": 2,
      "explanation": "Divide every term by 2: $y=2x+3$. The slope is 2, not 4."
    }
  ]
}
