{
  "id": "pc-trig-05",
  "version": 2,
  "title": "Inverse trig functions",
  "xp": 20,
  "tags": [
    "precalculus",
    "trigonometry",
    "inverse-functions"
  ],
  "learn": [
    {
      "id": "intro",
      "kind": "text",
      "title": "Going from a ratio back to an angle",
      "body": "Sine alone cannot be inverted, because many angles share one sine. So we cut each function down to a piece where it never repeats. Then $\\sin^{-1}$, $\\cos^{-1}$ and $\\tan^{-1}$ exist. They are called arcsine, arccosine and arctangent."
    },
    {
      "id": "p1",
      "kind": "text",
      "title": "Ranges to remember",
      "body": "$\\sin^{-1} x$ gives angles in $\\left[-\\frac{\\pi}{2},\\frac{\\pi}{2}\\right]$. $\\cos^{-1} x$ gives angles in $[0,\\pi]$. $\\tan^{-1} x$ gives angles between $-\\frac{\\pi}{2}$ and $\\frac{\\pi}{2}$. The input of $\\sin^{-1}$ and $\\cos^{-1}$ must be in $[-1,1]$."
    },
    {
      "id": "p2",
      "kind": "example",
      "title": "Find $\\sin^{-1}\\left(\\sin\\frac{5\\pi}{6}\\right)$",
      "body": "The answer must be in the allowed range.",
      "steps": [
        "$\\sin\\frac{5\\pi}{6}=\\frac12$",
        "$\\sin^{-1}\\frac12=\\frac{\\pi}{6}$",
        "The answer is $\\frac{\\pi}{6}$, not $\\frac{5\\pi}{6}$, because $\\frac{5\\pi}{6}$ is outside the range."
      ]
    },
    {
      "id": "p3",
      "kind": "example",
      "title": "A right triangle",
      "body": "Opposite side 3, hypotenuse 5.",
      "steps": [
        "$\\sin\\theta=\\frac35=0.6$",
        "$\\theta=\\sin^{-1}0.6$",
        "$\\theta\\approx 36.87^\\circ$"
      ]
    },
    {
      "id": "p4",
      "kind": "tip",
      "body": "$\\sin^{-1}x$ means the inverse function, not $\\frac{1}{\\sin x}$."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "type_answer",
      "prompt": "What is $\\tan^{-1} 1$ in degrees?",
      "accepted": [
        "45"
      ],
      "keypad": "numeric",
      "explanation": "$\\tan45^\\circ=1$."
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "What is $\\sin^{-1} 1$?",
      "choices": [
        "$0$",
        "$\\frac{\\pi}{2}$",
        "$\\pi$",
        "$1$"
      ],
      "answerIndex": 1,
      "explanation": "$\\sin\\frac{\\pi}{2}=1$."
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "What is $\\cos^{-1} 0$?",
      "choices": [
        "$0$",
        "$\\pi$",
        "$\\frac{\\pi}{2}$",
        "$\\frac{\\pi}{4}$"
      ],
      "answerIndex": 2,
      "explanation": "$\\cos\\frac{\\pi}{2}=0$, and it lies in $[0,\\pi]$."
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "What is $\\cos^{-1}(-1)$?",
      "choices": [
        "$0$",
        "$-\\pi$",
        "$\\frac{\\pi}{2}$",
        "$\\pi$"
      ],
      "answerIndex": 3,
      "explanation": "$\\cos\\pi=-1$."
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "What is $\\sin^{-1}\\left(-\\frac12\\right)$?",
      "choices": [
        "$-\\frac{\\pi}{6}$",
        "$\\frac{\\pi}{6}$",
        "$\\frac{7\\pi}{6}$",
        "$-\\frac{\\pi}{3}$"
      ],
      "answerIndex": 0,
      "explanation": "The output must be in $\\left[-\\frac{\\pi}{2},\\frac{\\pi}{2}\\right]$, and $\\sin\\left(-\\frac{\\pi}{6}\\right)=-\\frac12$."
    },
    {
      "id": "q6",
      "type": "type_answer",
      "prompt": "A right triangle has opposite 3 and hypotenuse 5. Find the angle in degrees to one decimal place.",
      "accepted": [
        "36.9",
        "36.87"
      ],
      "keypad": "numeric",
      "explanation": "$\\sin^{-1}0.6\\approx 36.87^\\circ$."
    },
    {
      "id": "q7",
      "type": "fill_blank",
      "prompt": "$\\sin^{-1} 2$ is \\_\\_.",
      "choices": [
        "$\\frac{\\pi}{2}$",
        "undefined",
        "$2$",
        "$0$"
      ],
      "answerIndex": 1,
      "explanation": "Sine never exceeds 1, so no angle has sine 2."
    },
    {
      "id": "q8",
      "type": "match_pairs",
      "prompt": "Match each inverse function to its output range.",
      "pairs": [
        [
          "$\\sin^{-1}$",
          "$\\left[-\\frac{\\pi}{2},\\frac{\\pi}{2}\\right]$"
        ],
        [
          "$\\cos^{-1}$",
          "$[0,\\pi]$"
        ],
        [
          "$\\tan^{-1}$",
          "between $-\\frac{\\pi}{2}$ and $\\frac{\\pi}{2}$"
        ]
      ],
      "explanation": "These ranges are chosen so each function is one-to-one."
    },
    {
      "id": "q9",
      "type": "multiple_choice",
      "prompt": "What is $\\sin^{-1}\\left(\\sin\\frac{5\\pi}{6}\\right)$?",
      "choices": [
        "$\\frac{5\\pi}{6}$",
        "$\\frac{\\pi}{3}$",
        "$\\frac{\\pi}{6}$",
        "$\\frac{7\\pi}{6}$"
      ],
      "answerIndex": 2,
      "explanation": "The result must lie in $\\left[-\\frac{\\pi}{2},\\frac{\\pi}{2}\\right]$."
    }
  ]
}
