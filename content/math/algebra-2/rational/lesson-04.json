      "prompt": "For $2,10,50,\\ldots$ find $a_4$.",
      "accepted": [
        "250"
      ],
      "keypad": "numeric",
      "explanation": "$r=5$, so $a_4=2\\cdot 5^3=250$."
    },
    {
      "id": "q5",
      "type": "type_answer",
