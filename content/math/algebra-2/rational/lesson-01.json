{
  "id": "a2-rational-01",
  "version": 2,
  "title": "Rational expressions",
  "xp": 15,
  "tags": [
    "algebra",
    "rational"
  ],
  "learn": [
    {
      "id": "p1",
      "kind": "text",
      "title": "Fractions made of polynomials",
      "body": "A rational expression is a polynomial divided by a polynomial, like $\\frac{x^2-9}{x^2+x-6}$. It follows the rules of fractions: factor, cancel common factors, and never allow a zero in the denominator. Values that make it zero are excluded."
    },
    {
      "id": "p2",
      "kind": "example",
      "title": "Simplify $\\frac{x^2-9}{x^2+x-6}$",
      "body": "Factor top and bottom first.",
      "steps": [
        "Top: $(x-3)(x+3)$. Bottom: $(x+3)(x-2)$",
        "Cancel $x+3$: $\\frac{x-3}{x-2}$",
        "Excluded values: $x\\ne -3$ and $x\\ne 2$"
      ]
    },
    {
      "id": "p3",
      "kind": "example",
      "title": "Add $\\frac{1}{x}+\\frac{1}{x+2}$",
      "body": "Use a common denominator $x(x+2)$.",
      "steps": [
        "$\\frac{x+2}{x(x+2)}+\\frac{x}{x(x+2)}$",
        "Add the tops: $\\frac{2x+2}{x(x+2)}$"
      ]
    },
    {
      "id": "p4",
      "kind": "tip",
      "body": "Cancel factors, never terms. In $\\frac{x+3}{x}$ you cannot cancel the $x$."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "type_answer",
      "prompt": "For $\\frac{5}{x-4}$, which value of $x$ is excluded?",
      "accepted": [
        "4"
      ],
      "keypad": "numeric",
      "explanation": "$x-4=0$ when $x=4$, and the denominator cannot be zero."
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "Simplify $\\frac{x^2-4}{x-2}$.",
      "choices": [
        "$x-2$",
        "$x+2$",
        "$x^2-2$"
      ],
      "answerIndex": 1,
      "explanation": "$x^2-4=(x-2)(x+2)$, and $x-2$ cancels. The result needs $x\\ne 2$."
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Simplify $\\frac{x^2-9}{x^2+x-6}$.",
      "choices": [
        "$\\frac{x-3}{x-2}$",
        "$\\frac{x+3}{x+2}$",
        "$\\frac{3}{x}$"
      ],
      "answerIndex": 0,
      "explanation": "Factor to $\\frac{(x-3)(x+3)}{(x+3)(x-2)}$ and cancel $x+3$."
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "What is $\\frac{2}{x}+\\frac{3}{x}$?",
      "choices": [
        "$\\frac{5}{2x}$",
        "$\\frac{6}{x}$",
        "$\\frac{5}{x}$"
      ],
      "answerIndex": 2,
      "explanation": "Same denominator, so add the tops: $\\frac{2+3}{x}$."
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "What is $\\frac{x}{3}+\\frac{x}{6}$?",
      "choices": [
        "$\\frac{2x}{9}$",
        "$\\frac{x}{2}$",
        "$\\frac{x}{9}$"
      ],
      "answerIndex": 1,
      "explanation": "Common denominator 6: $\\frac{2x}{6}+\\frac{x}{6}=\\frac{3x}{6}=\\frac{x}{2}$."
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "What is $\\frac{x}{x+1}\\cdot\\frac{x+1}{x^2}$?",
      "choices": [
        "$\\frac{1}{x}$",
        "$x$",
        "$\\frac{1}{x+1}$"
      ],
      "answerIndex": 0,
      "explanation": "Cancel $x+1$ and one $x$: $\\frac{x}{x^2}=\\frac{1}{x}$."
    },
    {
      "id": "q7",
      "type": "fill_blank",
      "prompt": "To add fractions you first need a common \\_\\_",
      "choices": [
        "numerator",
        "factor",
        "denominator"
      ],
      "answerIndex": 2,
      "explanation": "Only fractions with the same denominator can have their numerators added."
    },
    {
      "id": "q8",
      "type": "match_pairs",
      "prompt": "Match each expression to its excluded value.",
      "pairs": [
        [
          "$\\frac{1}{x-1}$",
          "$x\\ne 1$"
        ],
        [
          "$\\frac{3}{x+5}$",
          "$x\\ne -5$"
        ],
        [
          "$\\frac{2}{x}$",
          "$x\\ne 0$"
        ],
        [
          "$\\frac{4}{2x-6}$",
          "$x\\ne 3$"
        ]
      ],
      "explanation": "Set each denominator to 0. For $2x-6=0$, $x=3$."
    }
  ]
}