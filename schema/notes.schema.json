{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "notes.schema.json",
  "title": "Dopamine unit notes",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "blocks"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/block"
      }
    },
    "minApp": {
      "type": "integer",
      "minimum": 1
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "$ref": "#/definitions/text"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "code"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "title",
              "code"
            ]
          }
        }
      ]
    }
  }
}
