{
  "id": "a1-functions-04",
  "version": 1,
  "title": "Graphing lines",
  "xp": 15,
  "tags": [
    "algebra",
    "functions"
  ],
  "learn": [
    {
      "id": "two-ways",
      "kind": "text",
      "title": "Two ways to draw a line",
      "body": "A line needs only two points, but a third is a good check. You can start at the $y$-intercept and use the slope, or you can make a table of values."
    },
    {
      "id": "example-slope-graph",
      "kind": "example",
      "title": "Graph $y=2x-1$",
      "body": "Slope 2 means rise 2 for every 1 step right.",
      "steps": [
        "Mark the $y$-intercept $(0,-1)$",
        "Go right 1, up 2: $(1,1)$",
        "Go right 1, up 2 again: $(2,3)$",
        "Draw a straight line through the points."
      ]
    },
    {
      "id": "example-intercepts",
      "kind": "example",
      "title": "Intercepts of $y=2x-4$",
      "body": "Each intercept sets one variable to 0.",
      "steps": [
        "$y$-intercept: $x=0$ gives $y=-4$",
        "$x$-intercept: $y=0$ gives $2x=4$, so $x=2$",
        "The line passes through $(0,-4)$ and $(2,0)$."
      ]
    },
    {
      "id": "table",
      "kind": "text",
      "title": "A table of values",
      "body": "Choose a few $x$ values and compute $y$ from the equation. For $y=2x-1$: $x=0,1,2$ give $y=-1,1,3$. Each pair is a point on the line."
    },
    {
      "id": "third-point",
      "kind": "tip",
      "body": "If your three points do not line up, one of them is wrong. Recompute before you draw."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Where does $y=2x-1$ cross the $y$-axis?",
      "choices": [
        "$(-1,0)$",
        "$(0,-1)$",
        "$(0,2)$"
      ],
      "answerIndex": 1,
      "explanation": "Put $x=0$: $y=-1$. So the point is $(0,-1)$."
    },
    {
      "id": "q2",
      "type": "type_answer",
      "prompt": "For $y=2x-1$, find $y$ when $x=3$.",
      "accepted": [
        "5",
        "5.0"
      ],
      "keypad": "numeric",
      "explanation": "$2\\cdot3-1=5$, so $(3,5)$ is on the line."
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Start at $(0,1)$ on a line with slope $\\frac{3}{2}$. Which point is next?",
      "choices": [
        "$(2,4)$",
        "$(3,2)$",
        "$(1,4)$"
      ],
      "answerIndex": 0,
      "explanation": "Slope $\\frac{3}{2}$ means rise 3, run 2: from $(0,1)$ go right 2 and up 3."
    },
    {
      "id": "q4",
      "type": "fill_blank",
      "prompt": "To find the $x$-intercept, set \\_\\_ equal to 0.",
      "choices": [
        "$x$",
        "$y$",
        "$m$"
      ],
      "answerIndex": 1,
      "explanation": "On the $x$-axis the height is 0, so $y=0$."
    },
    {
      "id": "q5",
      "type": "type_answer",
      "prompt": "Find the $x$-intercept of $y=2x-4$.",
      "accepted": [
        "2",
        "2.0"
      ],
      "keypad": "numeric",
      "explanation": "Set $y=0$: $0=2x-4$, so $x=2$."
    },
    {
      "id": "q6",
      "type": "type_answer",
      "prompt": "Find the $x$-intercept of $y=-2x+6$.",
      "accepted": [
        "3",
        "3.0"
      ],
      "keypad": "numeric",
      "explanation": "$0=-2x+6$, so $2x=6$ and $x=3$."
    },
    {
      "id": "q7",
      "type": "match_pairs",
      "prompt": "Match each line with its $y$-intercept.",
      "pairs": [
        [
          "$y=2x+1$",
          "$(0,1)$"
        ],
        [
          "$y=x-3$",
          "$(0,-3)$"
        ],
        [
          "$y=-x+4$",
          "$(0,4)$"
        ]
      ],
      "explanation": "The constant term is the height where the line meets the $y$-axis."
    },
    {
      "id": "q8",
      "type": "multiple_choice",
      "prompt": "Which point lies on $y=3x-2$?",
      "choices": [
        "$(1,2)$",
        "$(0,2)$",
        "$(2,4)$"
      ],
      "answerIndex": 2,
      "explanation": "$3\\cdot2-2=4$. For $(1,2)$ you get $1$, and for $(0,2)$ you get $-2$."
    }
  ]
}
