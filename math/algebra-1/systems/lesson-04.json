{
  "id": "a1-systems-04",
  "version": 1,
  "title": "Systems by substitution",
  "xp": 20,
  "tags": [
    "algebra",
    "systems"
  ],
  "learn": [
    {
      "id": "idea",
      "kind": "text",
      "title": "Swap one letter for an expression",
      "body": "Graphing can be inexact. Substitution gives exact answers. If one equation says what $y$ equals, replace $y$ with that expression in the other equation. Only one letter is left."
    },
    {
      "id": "example-direct",
      "kind": "example",
      "title": "Solve $y=x+1$ and $2x+y=7$",
      "body": "$y$ is already alone, so substitute.",
      "steps": [
        "Replace $y$: $2x+(x+1)=7$",
        "Simplify: $3x+1=7$, so $x=2$",
        "Then $y=2+1=3$",
        "Check: $2\\cdot2+3=7$."
      ]
    },
    {
      "id": "isolate",
      "kind": "text",
      "title": "When no letter is alone",
      "body": "First solve one equation for one letter. For $x+y=5$, subtract $x$ to get $y=5-x$. Then substitute that into the other equation."
    },
    {
      "id": "example-isolate",
      "kind": "example",
      "title": "Solve $x+y=5$ and $3x-y=3$",
      "body": "Isolate $y$ first.",
      "steps": [
        "$y=5-x$",
        "Substitute: $3x-(5-x)=3$",
        "Simplify: $4x-5=3$, so $x=2$",
        "Then $y=5-2=3$."
      ]
    },
    {
      "id": "brackets",
      "kind": "tip",
      "body": "Put the substituted expression in brackets. Forgetting that the minus sign applies to the whole expression is a common slip."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "For $y=x+1$ and $2x+y=7$, what do you substitute?",
      "choices": [
        "Replace $x$ with $y+1$",
        "Replace $y$ with $x+1$",
        "Add the equations"
      ],
      "answerIndex": 1,
      "explanation": "The first equation already says what $y$ equals, so put $x+1$ in its place in the second."
    },
    {
      "id": "q2",
      "type": "type_answer",
      "prompt": "Solve $y=x+1$ and $2x+y=7$. $x=$ ?",
      "accepted": [
        "2",
        "2.0"
      ],
      "keypad": "numeric",
      "explanation": "$2x+(x+1)=7$, so $3x=6$ and $x=2$."
    },
    {
      "id": "q3",
      "type": "type_answer",
      "prompt": "In the same system, what is $y$?",
      "accepted": [
        "3",
        "3.0"
      ],
      "keypad": "numeric",
      "explanation": "$y=x+1=2+1=3$. Check: $2\\cdot2+3=7$."
    },
    {
      "id": "q4",
      "type": "type_answer",
      "prompt": "Solve $y=2x$ and $x+y=12$. $x=$ ?",
      "accepted": [
        "4",
        "4.0"
      ],
      "keypad": "numeric",
      "explanation": "$x+2x=12$, so $3x=12$ and $x=4$."
    },
    {
      "id": "q5",
      "type": "type_answer",
      "prompt": "In that system, what is $y$?",
      "accepted": [
        "8",
        "8.0"
      ],
      "keypad": "numeric",
      "explanation": "$y=2x=8$. Check: $4+8=12$."
    },
    {
      "id": "q6",
      "type": "fill_blank",
      "prompt": "From $x+y=5$ we get $y=\\_\\_$",
      "choices": [
        "$5-x$",
        "$5+x$",
        "$x-5$"
      ],
      "answerIndex": 0,
      "explanation": "Subtract $x$ from both sides."
    },
    {
      "id": "q7",
      "type": "type_answer",
      "prompt": "Solve $x+y=5$ and $3x-y=3$. $x=$ ?",
      "accepted": [
        "2",
        "2.0"
      ],
      "keypad": "numeric",
      "explanation": "$y=5-x$. Then $3x-(5-x)=3$, so $4x=8$ and $x=2$. Then $y=3$."
    },
    {
      "id": "q8",
      "type": "multiple_choice",
      "prompt": "Solve $y=x+1$ and $y=2x-3$.",
      "choices": [
        "$(2,3)$",
        "$(1,2)$",
        "$(4,5)$"
      ],
      "answerIndex": 2,
      "explanation": "Set $x+1=2x-3$: $x=4$, and $y=5$. Check: $2\\cdot4-3=5$."
    },
    {
      "id": "q9",
      "type": "order_steps",
      "prompt": "Put the substitution steps in order.",
      "steps": [
        "Solve one equation for a letter",
        "Substitute into the other equation",
        "Solve, then find the second letter and check"
      ],
      "explanation": "Substitution replaces one unknown so only one letter remains."
    }
  ]
}
