      "type": "multiple_choice",
      "prompt": "Solve $x+3=7$",
      "choices": ["$x=4$", "$x=10$", "$x=-4$"],
      "answerIndex": 0,
      "explanation": "Subtract 3 from both sides: $x=7-3=4$."
    },
    {
      "id": "q2",
      "type": "type_answer",
      "prompt": "$2x=10$, so $x=$ ?",
      "accepted": ["5", "5.0"],
      "keypad": "numeric",
      "explanation": "Divide both sides by 2: $x=\\frac{10}{2}=5$."
    },
    {
      "id": "q3",
      "type": "fill_blank",
      "prompt": "$\\frac{a}{b}+\\frac{c}{b}=\\frac{\\_\\_}{b}$",
      "choices": ["$a+c$", "$ac$", "$a-c$"],
      "answerIndex": 0,
      "explanation": "Same denominator, so add the numerators."
    },
    {
      "id": "q4",
      "type": "match_pairs",
      "prompt": "Match each notation with its name.",
      "pairs": [["$x^2$", "square"], ["$\\sqrt{x}$", "root"], ["$|x|$", "absolute value"]],
      "explanation": "A square multiplies by itself, a root undoes it, and the bars give distance from zero."
    },
    {
      "id": "q5",
      "type": "order_steps",
      "prompt": "Solve $2x+3=7$. Put the steps in order.",
      "steps": ["Subtract 3 from both sides", "Divide both sides by 2", "State that x is 2"],
      "explanation": "Undo the operations in reverse order: first the addition, then the multiplication."
    },
