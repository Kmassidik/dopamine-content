{
  "id": "linear-eq-notes",
  "version": 2,
  "title": "Linear equations: cheat sheet",
  "blocks": [
    {
      "id": "big-idea",
      "kind": "text",
      "title": "The big idea",
      "body": "An equation is a balance. Whatever you do to one side, do to the other. Your goal is to get $x$ alone."
    },
    {
      "id": "opposites",
      "kind": "list",
      "title": "Undo with the opposite",
      "items": [
        "Adding is undone by subtracting",
        "Subtracting is undone by adding",
        "Multiplying is undone by dividing",
        "Dividing is undone by multiplying"
      ]
    },
    {
      "id": "add-subtract",
      "kind": "formula",
      "title": "Add or subtract",
      "body": "$x+a=b\\ \\Rightarrow\\ x=b-a$"
    },
    {
      "id": "multiply-divide",
      "kind": "formula",
      "title": "Multiply or divide",
      "body": "$ax=b\\ \\Rightarrow\\ x=\\frac{b}{a}$"
    },
    {
      "id": "two-step",
      "kind": "formula",
      "title": "Two steps",
      "body": "$ax+b=c\\ \\Rightarrow\\ x=\\frac{c-b}{a}$"
    },
    {
      "id": "notation",
      "kind": "list",
      "title": "Notation",
      "items": [
        "$x^2$ is a square: $x$ times itself",
        "$\\sqrt{x}$ is the root of $x$",
        "$|x|$ is the distance from zero",
        "$\\frac{a}{b}+\\frac{c}{b}=\\frac{a+c}{b}$"
      ]
    },
    {
      "id": "both-sides",
      "kind": "list",
      "title": "Variables on both sides",
      "items": [
        "Gather the $x$ terms on one side first",
        "Then gather the plain numbers on the other",
        "$2x+1=2x+5$ gives $1=5$: no solution",
        "A true result like $3=3$: every number works"
      ]
    },
    {
      "id": "brackets-fractions",
      "kind": "list",
      "title": "Brackets and fractions",
      "items": [
        "Distribute: $a(b+c)=ab+ac$",
        "Clear fractions: multiply every term by the common denominator",
        "Then solve as an ordinary equation"
      ]
    },
    {
      "id": "word-problems",
      "kind": "list",
      "title": "Word problems and formulas",
      "items": [
        "Name the unknown, write the equation, solve, check",
        "Solve for a letter: treat other letters as numbers",
        "$d=rt\\ \\Rightarrow\\ t=\\frac{d}{r}$"
      ]
    },
    {
      "id": "check",
      "kind": "tip",
      "body": "Always check: put your answer back into the original equation."
    }
  ]
}
