{
  "id": "pc-trig-06",
  "version": 1,
  "title": "Trig identities",
  "xp": 20,
  "tags": [
    "precalculus",
    "trigonometry",
    "identities"
  ],
  "learn": [
    {
      "id": "intro",
      "kind": "text",
      "title": "Equations that are always true",
      "body": "An identity is true for every angle where both sides are defined. The most important is $\\sin^2\\theta+\\cos^2\\theta=1$, which comes straight from the unit circle. Dividing it by $\\cos^2\\theta$ gives $1+\\tan^2\\theta=\\operatorname{sec}^2\\theta$."
    },
    {
      "id": "p1",
      "kind": "text",
      "title": "Double and sum formulas",
      "body": "$\\sin2\\theta=2\\sin\\theta\\cos\\theta$. $\\cos2\\theta=\\cos^2\\theta-\\sin^2\\theta=1-2\\sin^2\\theta$. And $\\sin(a+b)=\\sin a\\cos b+\\cos a\\sin b$."
    },
    {
      "id": "p2",
      "kind": "example",
      "title": "Simplify $\\frac{1-\\cos^2x}{\\sin x}$",
      "body": "Use the Pythagorean identity.",
      "steps": [
        "$1-\\cos^2x=\\sin^2x$",
        "So the fraction is $\\frac{\\sin^2x}{\\sin x}$",
        "Cancel: $\\sin x$"
      ]
    },
    {
      "id": "p3",
      "kind": "example",
      "title": "Find $\\sin75^\\circ$",
      "body": "Write $75^\\circ=45^\\circ+30^\\circ$.",
      "steps": [
        "$\\sin45^\\circ\\cos30^\\circ+\\cos45^\\circ\\sin30^\\circ$",
        "$=\\frac{\\sqrt2}{2}\\cdot\\frac{\\sqrt3}{2}+\\frac{\\sqrt2}{2}\\cdot\\frac12$",
        "$=\\frac{\\sqrt6+\\sqrt2}{4}\\approx 0.9659$"
      ]
    },
    {
      "id": "p4",
      "kind": "tip",
      "body": "To prove an identity, work on one side only until it matches the other."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "What does $\\sin^2\\theta+\\cos^2\\theta$ equal?",
      "choices": [
        "0",
        "$2$",
        "$\\sin2\\theta$",
        "1"
      ],
      "answerIndex": 3,
      "explanation": "It is the equation of the unit circle."
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "Simplify $1-\\sin^2x$.",
      "choices": [
        "$\\cos^2x$",
        "$\\sin^2x$",
        "$\\cos 2x$",
        "$1$"
      ],
      "answerIndex": 0,
      "explanation": "Rearrange $\\sin^2x+\\cos^2x=1$."
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Simplify $\\tan x\\cos x$.",
      "choices": [
        "$\\cos x$",
        "$\\sin x$",
        "$\\operatorname{sec} x$",
        "$1$"
      ],
      "answerIndex": 1,
      "explanation": "$\\frac{\\sin x}{\\cos x}\\cdot\\cos x=\\sin x$."
    },
    {
      "id": "q4",
      "type": "type_answer",
      "prompt": "If $\\sin\\theta=\\frac35$ and $\\cos\\theta=\\frac45$, find $\\sin2\\theta$ as a decimal.",
      "accepted": [
        "0.96",
        "24/25"
      ],
      "keypad": "numeric",
      "explanation": "$2\\cdot\\frac35\\cdot\\frac45=\\frac{24}{25}=0.96$."
    },
    {
      "id": "q5",
      "type": "type_answer",
      "prompt": "If $\\sin\\theta=0.6$, find $\\cos2\\theta$ using $1-2\\sin^2\\theta$.",
      "accepted": [
        "0.28",
        "7/25"
      ],
      "keypad": "numeric",
      "explanation": "$1-2(0.36)=0.28$."
    },
    {
      "id": "q6",
      "type": "fill_blank",
      "prompt": "$1+\\tan^2\\theta=$ \\_\\_.",
      "choices": [
        "$\\operatorname{csc}^2\\theta$",
        "$\\cos^2\\theta$",
        "$\\operatorname{sec}^2\\theta$",
        "$1$"
      ],
      "answerIndex": 2,
      "explanation": "Divide $\\sin^2+\\cos^2=1$ by $\\cos^2$."
    },
    {
      "id": "q7",
      "type": "match_pairs",
      "prompt": "Match each formula to its name.",
      "pairs": [
        [
          "$\\sin^2\\theta+\\cos^2\\theta=1$",
          "Pythagorean identity"
        ],
        [
          "$\\sin2\\theta=2\\sin\\theta\\cos\\theta$",
          "double angle"
        ],
        [
          "$\\tan\\theta=\\frac{\\sin\\theta}{\\cos\\theta}$",
          "quotient identity"
        ]
      ],
      "explanation": "Names help you find the right tool."
    },
    {
      "id": "q8",
      "type": "multiple_choice",
      "prompt": "Is $\\sin(a+b)=\\sin a+\\sin b$ an identity?",
      "choices": [
        "Yes, always",
        "Yes, only in radians",
        "Only for acute angles",
        "No, for example $a=b=90^\\circ$ gives $0$ on the left and $2$ on the right"
      ],
      "answerIndex": 3,
      "explanation": "$\\sin180^\\circ=0$ but $\\sin90^\\circ+\\sin90^\\circ=2$. Use the sum formula instead."
    },
    {
      "id": "q9",
      "type": "order_steps",
      "prompt": "Prove $\\frac{1-\\cos^2x}{\\sin x}=\\sin x$. Put the steps in order.",
      "steps": [
        "Start with the left side",
        "Replace $1-\\cos^2x$ by $\\sin^2x$",
        "Cancel one $\\sin x$",
        "Reach $\\sin x$, the right side"
      ],
      "explanation": "Work one side until it matches the other."
    }
  ]
}
