{
  "id": "a2-rational-03",
  "version": 1,
  "title": "Arithmetic sequences",
  "xp": 15,
  "tags": [
    "algebra",
    "sequences"
  ],
  "learn": [
    {
      "id": "p1",
      "kind": "text",
      "title": "Adding the same amount",
      "body": "A sequence is an ordered list of numbers. In an arithmetic sequence each term is the previous one plus a fixed number, the common difference $d$. For $5,8,11,14,\\ldots$ the difference is $d=3$."
    },
    {
      "id": "p2",
      "kind": "text",
      "title": "The $n$th term",
      "body": "Reach term $n$ from the first term by adding $d$ exactly $n-1$ times: $a_n=a_1+(n-1)d$. Use it to jump straight to any term without listing the ones before."
    },
    {
      "id": "p3",
      "kind": "example",
      "title": "The sequence $5,8,11,\\ldots$",
      "body": "Here $a_1=5$ and $d=3$.",
      "steps": [
        "Term 20: $a_{20}=5+19\\cdot 3=62$",
        "Which term is 50? Solve $5+(n-1)\\cdot 3=50$",
        "$(n-1)\\cdot 3=45$, so $n-1=15$",
        "$n=16$"
      ]
    },
    {
      "id": "p4",
      "kind": "tip",
      "body": "To find $d$, subtract any term from the one after it. From terms $a_3=11$ and $a_7=23$: four steps add 12, so $d=3$."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "type_answer",
      "prompt": "Find the common difference of $5,8,11,14,\\ldots$",
      "accepted": [
        "3"
      ],
      "keypad": "numeric",
      "explanation": "$8-5=3$."
    },
    {
      "id": "q2",
      "type": "type_answer",
      "prompt": "For $5,8,11,\\ldots$ find $a_{20}$.",
      "accepted": [
        "62"
      ],
      "keypad": "numeric",
      "explanation": "$a_{20}=5+19\\cdot 3=62$."
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Which sequence is arithmetic?",
      "choices": [
        "$1,2,4,8,\\ldots$",
        "$1,4,9,16,\\ldots$",
        "$2,5,8,11,\\ldots$"
      ],
      "answerIndex": 2,
      "explanation": "Only the first adds the same number (3) each time."
    },
    {
      "id": "q4",
      "type": "type_answer",
      "prompt": "$a_1=2$ and $d=-3$. Find $a_5$.",
      "accepted": [
        "-10",
        "−10"
      ],
      "keypad": "numeric",
      "explanation": "$2+4\\cdot(-3)=2-12=-10$."
    },
    {
      "id": "q5",
      "type": "type_answer",
      "prompt": "In $5,8,11,\\ldots$ which term number is 50?",
      "accepted": [
        "16"
      ],
      "keypad": "numeric",
      "explanation": "$5+(n-1)\\cdot 3=50$ gives $n-1=15$, so $n=16$."
    },
    {
      "id": "q6",
      "type": "type_answer",
      "prompt": "An arithmetic sequence has $a_3=11$ and $a_7=23$. Find $d$.",
      "accepted": [
        "3"
      ],
      "keypad": "numeric",
      "explanation": "From term 3 to term 7 is 4 steps, adding 12 in total, so $d=\\frac{12}{4}=3$."
    },
    {
      "id": "q7",
      "type": "fill_blank",
      "prompt": "In $a_n=a_1+(n-1)d$ we add $d$ exactly \\_\\_ times",
      "choices": [
        "$n$",
        "$n-1$",
        "$n+1$"
      ],
      "answerIndex": 1,
      "explanation": "Term 1 needs no steps, term 2 needs one step, so term $n$ needs $n-1$ steps."
    },
    {
      "id": "q8",
      "type": "match_pairs",
      "prompt": "Match each sequence to its common difference.",
      "pairs": [
        [
          "$10,7,4,1$",
          "$-3$"
        ],
        [
          "$4,9,14,19$",
          "$5$"
        ],
        [
          "$0.5,1,1.5,2$",
          "$0.5$"
        ],
        [
          "$7,7,7,7$",
          "$0$"
        ]
      ],
      "explanation": "Subtract each term from the next one. A decreasing sequence has a negative difference."
    }
  ]
}